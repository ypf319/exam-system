<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.exam.mapper.PaperQuestionMapper">

    <select id="selectByPaperId" resultType="com.exam.entity.PaperQuestion">
        SELECT * FROM `paper_question` WHERE paper_id = #{paperId} ORDER BY id
    </select>

    <select id="selectQuestionVOByPaperId" resultType="com.exam.vo.PaperQuestionVO">
        SELECT q.id AS question_id,
               q.title,
               q.question_type,
               q.option_a,
               q.option_b,
               q.option_c,
               q.option_d,
               q.answer,
               pq.score,
               q.difficulty,
               q.course_id
        FROM `paper_question` pq
        INNER JOIN `question` q ON pq.question_id = q.id
        WHERE pq.paper_id = #{paperId}
        ORDER BY pq.id
    </select>

    <insert id="insertBatch">
        INSERT INTO `paper_question` (paper_id, question_id, score)
        VALUES
        <foreach collection="list" item="item" separator=",">
            (#{item.paperId}, #{item.questionId}, #{item.score})
        </foreach>
    </insert>

    <delete id="deleteByPaperId">
        DELETE FROM `paper_question` WHERE paper_id = #{paperId}
    </delete>

    <select id="countByQuestionId" resultType="int">
        SELECT COUNT(*) FROM `paper_question` WHERE question_id = #{questionId}
    </select>
</mapper>
